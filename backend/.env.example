FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Used for the historical/aggregated income & production feature.
# Without a reachable Postgres instance, the collector logs a warning and
# disables itself — the rest of the app still works fine.
DATABASE_URL=postgresql://solvann:solvann@localhost:5432/solvann
ENABLE_HISTORY_COLLECTOR=true
